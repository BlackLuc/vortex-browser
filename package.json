{
  "name": "my-browser",
  "version": "0.1.12",
  "description": "A minimal tabbed web browser built with Electron",
  "main": "website/vortex-entry.cjs",
  "build": {
    "appId": "app.vortex.browser",
    "productName": "Vortex Browser",
    "directories": {
      "output": "electron-release"
    },
    "files": [
      "**/*",
      "!electron-release/**",
      "!.git/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "website/icons/vortex.ico",
      "artifactName": "Vortex-Browser-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": {
      "provider": "github",
      "owner": "BlackLuc",
      "repo": "vortex-browser",
      "releaseType": "release"
    }
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron ."
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@electron/packager": "^20.3.0",
    "electron-updater": "^6.8.11"
  }
}
